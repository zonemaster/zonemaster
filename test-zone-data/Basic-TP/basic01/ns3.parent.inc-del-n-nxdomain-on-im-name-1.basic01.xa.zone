$ORIGIN parent.inc-del-n-nxdomain-on-im-name-1.basic01.xa. ; ns3

$TTL 3600

@       SOA     ns1 admin. (
                2026060503      ; serial
                6h              ; refresh
                1h              ; retry
                1w              ; expire
                1d )            ; minimum
                

@		NS	ns1
@		NS	ns2
@		NS	ns3
ns1		A	127.12.1.41
ns1		AAAA	fda1:b2:c3:0:127:12:1:41
ns2		A	127.12.1.42
ns2		AAAA	fda1:b2:c3:0:127:12:1:42
ns3		A	127.12.1.43
ns3		AAAA	fda1:b2:c3:0:127:12:1:43


$ORIGIN child.im             ; Must not end with "."

@		NS	ns1-delegated-child.basic01.xa.  ; Dummy server
@		NS	ns2-delegated-child.basic01.xa.  ; Dummy server



