$ORIGIN .
$TTL 3600

@       SOA     ns1. admin.xa. (
                2026071404      ; serial
                6h              ; refresh
                1h              ; retry
                1w              ; expire
                1d )            ; minimum

          NS     ns1.
          NS     ns2.

ns1.      A      127.19.9.61
ns1.      AAAA   fda1:b2:c3::127:19:9:61

ns1.      A      127.19.9.62
ns1.      AAAA   fda1:b2:c3::127:19:9:62


$ORIGIN zone09.xa.                              ; Must end with "."
@               NS    ns1
@               NS    ns2
ns1             A     127.19.9.21
ns1             AAAA  fda1:b2:c3::127:19:9:21
ns2             A     127.19.9.22
ns2             AAAA  fda1:b2:c3::127:19:9:22

; For TLD scenarios:

$ORIGIN tld-email-domain-zone09.
@                               NS     ns1
@                               NS     ns2
ns1                             A      127.19.9.41
ns1                             AAAA   fda1:b2:c3::127:19:9:41
ns2                             A      127.19.9.42
ns2                             AAAA   fda1:b2:c3::127:19:9:42

$ORIGIN null-mx-tld-zone09.
@                               NS     ns1
@                               NS     ns2
ns1                             A      127.19.9.41
ns1                             AAAA   fda1:b2:c3::127:19:9:41
ns2                             A      127.19.9.42
ns2                             AAAA   fda1:b2:c3::127:19:9:42

$ORIGIN no-mx-tld-zone09.
@                               NS     ns1
@                               NS     ns2
ns1                             A      127.19.9.41
ns1                             AAAA   fda1:b2:c3::127:19:9:41
ns2                             A      127.19.9.42
ns2                             AAAA   fda1:b2:c3::127:19:9:42

; For ARPA scenarios:

$ORIGIN arpa-email-domain.zone09.arpa.
@                               NS     ns1
@                               NS     ns2
ns1                             A      127.19.9.31
ns1                             AAAA   fda1:b2:c3::127:19:9:31
ns2                             A      127.19.9.32
ns2                             AAAA   fda1:b2:c3::127:19:9:32

$ORIGIN null-mx-arpa.zone09.arpa.
@                               NS     ns1
@                               NS     ns2
ns1                             A      127.19.9.31
ns1                             AAAA   fda1:b2:c3::127:19:9:31
ns2                             A      127.19.9.32
ns2                             AAAA   fda1:b2:c3::127:19:9:32

$ORIGIN no-mx-arpa.zone09.arpa.
@                               NS     ns1
@                               NS     ns2
ns1                             A      127.19.9.31
ns1                             AAAA   fda1:b2:c3::127:19:9:31
ns2                             A      127.19.9.32
ns2                             AAAA   fda1:b2:c3::127:19:9:32



;EOF
