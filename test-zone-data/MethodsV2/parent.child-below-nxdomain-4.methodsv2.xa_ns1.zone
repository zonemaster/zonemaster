ns1		A	127.40.1.41
ns1		AAAA	fda1:b2:c3:0:127:40:1:41
ns2		A	127.40.1.42
ns2		AAAA	fda1:b2:c3:0:127:40:1:42


$ORIGIN child.im.parent.child-below-nxdomain-4.methodsv2.xa.   ; Must end with "."
