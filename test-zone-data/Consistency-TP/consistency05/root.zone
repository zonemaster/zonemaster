; Dedicated general root zone for Consistency05

$ORIGIN .
$TTL 3600

@       SOA     ns1. admin.xa. (
                2026080500      ; serial
                6h              ; refresh
                1h              ; retry
                1w              ; expire
                1d )            ; minimum

          NS     ns1.
          NS     ns2.

ns1.      A      127.14.5.61
ns1.      AAAA   fda1:b2:c3:0:127:14:5:61
ns2.      A      127.14.5.62
ns3.      AAAA   fda1:b2:c3:0:127:14:5:62


$ORIGIN consistency05.xa.                              ; Must end with "."
@               NS    ns1
@               NS    ns2
ns1             A     127.14.5.21
ns1             AAAA  fda1:b2:c3:0:127:14:5:21
ns2             A     127.14.5.22
ns2             AAAA  fda1:b2:c3:0:127:14:5:22

$ORIGIN consistency05.xb.                              ; Must end with "."
@               NS    ns1
@               NS    ns2
ns1             A     127.14.5.23
ns1             AAAA  fda1:b2:c3:0:127:14:5:23
ns2             A     127.14.5.24
ns2             AAAA  fda1:b2:c3:0:127:14:5:24

;EOF
