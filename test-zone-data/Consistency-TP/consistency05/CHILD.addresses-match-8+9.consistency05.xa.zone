; No $ORIGIN, taken from loading. Names must be relative to the zone name.

$TTL 3600

@       SOA     ns3 admin.mail.xa. (
                2026070104      ; serial
                6h              ; refresh
                1h              ; retry
                1w              ; expire
                1d )            ; minimum

@       NS      ns41
@       NS      ns42

@       TXT     "Text"

;EOF
